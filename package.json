{
  "name": "@hintoai/cli",
  "version": "0.1.0",
  "description": "Hinto AI CLI — manage videos, articles, and publishing via the Hinto API",
  "main": "dist/index.js",
  "bin": {
    "hinto": "./dist/index.js"
  },
  "files": ["dist/"],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "homepage": "https://github.com/hintoai/hinto-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hintoai/hinto-cli.git"
  },
  "bugs": {
    "url": "https://github.com/hintoai/hinto-cli/issues"
  },
  "keywords": ["hinto", "cli", "video", "articles", "publishing", "ai", "agent-skill"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "biome check .",
    "format": "biome format --write .",
    "validate:skill": "node scripts/validate-skill.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "^2.31.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "nock": "^13.5.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  }
}
